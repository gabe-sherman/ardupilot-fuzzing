msg_mission_request_list      = "\x2b\x00\x00"
msg_mission_count              = "\x2c\x00\x00"
msg_mission_clear_all          = "\x2d\x00\x00"
msg_mission_ack                 = "\x2f\x00\x00"
msg_set_gps_global_origin        = "\x30\x00\x00"
msg_mission_request_int          = "\x33\x00\x00"
