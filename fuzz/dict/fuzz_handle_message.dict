# AFL++ dictionary for fuzz_handle_message.
#
# Input is a sequence of records: u8 sysid, u8 compid, u24 msgid (LE),
# u8 len, payload. These tokens are the fixed-shape header fields; payload
# constants (MAV_CMD values etc.) are left to the fuzzer's mutations.

gcs_sender                  = "\xff\xbe"

msg_heartbeat               = "\x00\x00\x00"
msg_set_mode                = "\x0b\x00\x00"
msg_param_request_read      = "\x14\x00\x00"
